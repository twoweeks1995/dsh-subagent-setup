{
  "name": "dsh-subagent-setup",
  "version": "0.2.0",
  "description": "给 DeepSeek Harness 的子智能体模型路由：按别名把子智能体委派到指定的子智能体代理与模型，支持标签、默认思考档位与界面开关；配置存本地 JSON，不写 YAML。",
  "type": "module",
  "main": "plugin/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json",
    "./session": "./plugin/session.mjs"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check plugin/index.js && node --check plugin/session.mjs && node --check plugin/client.js && node --check plugin/tools.mjs && node --check plugin/tracker.mjs && node --check plugin/routes.mjs && node --check src/config.mjs && node --check src/store.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "author": "twoweeks1995",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "subagent",
    "model-routing",
    "reasoning-effort",
    "zh-cn"
  ],
  "files": [
    "plugin/",
    "src/",
    "skills/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twoweeks1995/dsh-subagent-setup.git"
  },
  "homepage": "https://github.com/twoweeks1995/dsh-subagent-setup#readme",
  "bugs": {
    "url": "https://github.com/twoweeks1995/dsh-subagent-setup/issues"
  }
}
